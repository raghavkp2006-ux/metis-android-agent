{
  "$id": "urn:metis:nlu:data:001",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "ood": {
            "const": false
          }
        }
      },
      "if": {
        "properties": {
          "disposition": {
            "const": "OUT_OF_DOMAIN"
          }
        }
      },
      "then": {
        "properties": {
          "action": {
            "const": "NONE"
          },
          "domain": {
            "const": "UNKNOWN"
          },
          "ood": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "enum": [
              "SUPPORTED_COMPLETE",
              "SUPPORTED_NEEDS_CONTEXT",
              "SUPPORTED_NEEDS_CONFIRMATION"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "action": {
            "not": {
              "const": "NONE"
            }
          },
          "domain": {
            "not": {
              "const": "UNKNOWN"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "domain": {
            "const": "UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "action": {
            "const": "NONE"
          },
          "disposition": {
            "enum": [
              "KNOWN_UNSUPPORTED",
              "OUT_OF_DOMAIN"
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "action": {
      "enum": [
        "READ",
        "CREATE",
        "UPDATE",
        "DELETE",
        "COMPLETE",
        "POSTPONE",
        "START",
        "STOP",
        "SET",
        "PLAN",
        "REVIEW",
        "CALL",
        "SEND",
        "NAVIGATE",
        "RECOMMEND",
        "NONE"
      ],
      "type": "string"
    },
    "bio_tags": {
      "items": {
        "enum": [
          "O",
          "B-PERSON",
          "I-PERSON",
          "B-SUBJECT",
          "I-SUBJECT",
          "B-DATE",
          "I-DATE",
          "B-TIME",
          "I-TIME",
          "B-DATE_RANGE",
          "I-DATE_RANGE",
          "B-DURATION",
          "I-DURATION",
          "B-STATUS",
          "I-STATUS",
          "B-PRIORITY",
          "I-PRIORITY",
          "B-LOCATION",
          "I-LOCATION",
          "B-PROJECT",
          "I-PROJECT",
          "B-GOAL",
          "I-GOAL",
          "B-TASK",
          "I-TASK",
          "B-EVENT",
          "I-EVENT",
          "B-FIELD",
          "I-FIELD",
          "B-KIND",
          "I-KIND",
          "B-RECURRENCE",
          "I-RECURRENCE",
          "B-QUANTITY",
          "I-QUANTITY",
          "B-CHANNEL",
          "I-CHANNEL",
          "B-PREFERENCE_VALUE",
          "I-PREFERENCE_VALUE",
          "B-REFERENCE",
          "I-REFERENCE"
        ],
        "type": "string"
      },
      "maxItems": 4000,
      "minItems": 1,
      "type": "array"
    },
    "composition": {
      "type": [
        "object",
        "null"
      ]
    },
    "disposition": {
      "enum": [
        "SUPPORTED_COMPLETE",
        "SUPPORTED_NEEDS_CONTEXT",
        "SUPPORTED_NEEDS_CONFIRMATION",
        "KNOWN_UNSUPPORTED",
        "OUT_OF_DOMAIN"
      ],
      "type": "string"
    },
    "domain": {
      "enum": [
        "TASK",
        "CALENDAR",
        "MEMORY",
        "PROMISE",
        "PERSON",
        "GOAL",
        "PROJECT",
        "PLANNING",
        "REMINDER",
        "ALARM",
        "TIMER",
        "FOCUS",
        "HABIT",
        "COMMUNICATION",
        "NAVIGATION",
        "PREFERENCE",
        "REFLECTION",
        "KNOWLEDGE",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "family": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "family_registry_version": {
      "const": "nlu_v1_families_001"
    },
    "generation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "generator_id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$",
              "type": "string"
            },
            "parent_ids": {
              "items": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "maxItems": 64,
              "type": "array",
              "uniqueItems": true
            },
            "seed": {
              "minimum": 0,
              "type": "integer"
            },
            "template_id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$",
              "type": "string"
            }
          },
          "required": [
            "parent_ids",
            "seed",
            "generator_id",
            "template_id"
          ],
          "type": "object"
        }
      ]
    },
    "id": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "nlu_schema_version": {
      "const": "nlu_v1_schema_001"
    },
    "ood": {
      "type": "boolean"
    },
    "partition": {
      "enum": [
        "UNASSIGNED",
        "TRAIN",
        "DEVELOPMENT",
        "CALIBRATION",
        "SELECTION",
        "PROTECTED_EVALUATION",
        "FINAL_INDEPENDENT_TEST"
      ]
    },
    "privacy": {
      "enum": [
        "PUBLIC",
        "PRIVATE",
        "RESTRICTED",
        "UNKNOWN_PRIVACY"
      ]
    },
    "privacy_review": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "binding_sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "license_id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$",
              "type": "string"
            },
            "publication_allowed": {
              "type": "boolean"
            },
            "review_id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$",
              "type": "string"
            },
            "reviewed_at": {
              "type": "string"
            },
            "reviewer_id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$",
              "type": "string"
            }
          },
          "required": [
            "binding_sha256",
            "review_id",
            "reviewer_id",
            "reviewed_at",
            "publication_allowed",
            "license_id"
          ],
          "type": "object"
        }
      ]
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "family_definition_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "import_batch_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$",
          "type": "string"
        },
        "import_file_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "import_row_number": {
          "minimum": 1,
          "type": "integer"
        },
        "ingestion_row_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "mapping_configuration_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "scenario_definition_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_registry_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "source_registry_version": {
          "const": "nlu_v1_sources_001"
        },
        "upstream_privacy": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "ingestion_row_sha256",
        "import_batch_id",
        "import_row_number",
        "import_file_sha256",
        "mapping_configuration_sha256",
        "source_registry_sha256",
        "family_definition_sha256",
        "scenario_definition_sha256",
        "source_registry_version",
        "upstream_privacy"
      ],
      "type": "object"
    },
    "quarantine_reasons": {
      "items": {
        "pattern": "^[A-Z][A-Z0-9_]*$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "review_history": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$",
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "binding_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "event_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "evidence_sha256": {
            "anyOf": [
              {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "next": {
            "enum": [
              "PENDING",
              "AUTO_VALIDATED",
              "HUMAN_REVIEWED",
              "APPROVED",
              "REJECTED",
              "QUARANTINED"
            ]
          },
          "previous": {
            "anyOf": [
              {
                "enum": [
                  "PENDING",
                  "AUTO_VALIDATED",
                  "HUMAN_REVIEWED",
                  "APPROVED",
                  "REJECTED",
                  "QUARANTINED"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "previous_event_sha256": {
            "anyOf": [
              {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "type": "string"
          },
          "review_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "previous",
          "next",
          "actor",
          "reason",
          "at",
          "binding_sha256",
          "review_id",
          "evidence_sha256",
          "previous_event_sha256",
          "event_sha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "review_status": {
      "enum": [
        "PENDING",
        "AUTO_VALIDATED",
        "HUMAN_REVIEWED",
        "APPROVED",
        "REJECTED",
        "QUARANTINED"
      ]
    },
    "scenario_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "scenario_registry_version": {
      "const": "nlu_v1_scenarios_001"
    },
    "schema_version": {
      "const": "nlu_v1_data_001"
    },
    "semantic_parent_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "slots": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "minimum": 1,
            "type": "integer"
          },
          "start": {
            "minimum": 0,
            "type": "integer"
          },
          "text": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "enum": [
              "PERSON",
              "SUBJECT",
              "DATE",
              "TIME",
              "DATE_RANGE",
              "DURATION",
              "STATUS",
              "PRIORITY",
              "LOCATION",
              "PROJECT",
              "GOAL",
              "TASK",
              "EVENT",
              "FIELD",
              "KIND",
              "RECURRENCE",
              "QUANTITY",
              "CHANNEL",
              "PREFERENCE_VALUE",
              "REFERENCE"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "start",
          "end",
          "text"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "type": "array"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "dataset": {
          "minLength": 1,
          "type": "string"
        },
        "intake_approval_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mapper_version": {
          "minLength": 1,
          "type": "string"
        },
        "mapping_decision": {
          "enum": [
            "MAP",
            "KNOWN_UNSUPPORTED",
            "OOD"
          ]
        },
        "mapping_version": {
          "minLength": 1,
          "type": "string"
        },
        "original_intent": {
          "minLength": 1,
          "type": "string"
        },
        "original_split": {
          "minLength": 1,
          "type": "string"
        },
        "source_class": {
          "enum": [
            "PUBLIC_DATASET",
            "TRAINABLE_LEGACY",
            "CONTROLLED_SYNTHETIC",
            "INDEPENDENT_EVALUATION"
          ]
        },
        "source_id": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "dataset",
        "version",
        "source_id",
        "original_split",
        "original_intent",
        "mapper_version",
        "mapping_version",
        "mapping_decision",
        "artifact_sha256",
        "intake_approval_id",
        "source_class"
      ],
      "type": "object"
    },
    "text": {
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    },
    "text_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "tokens": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "minimum": 1,
            "type": "integer"
          },
          "start": {
            "minimum": 0,
            "type": "integer"
          },
          "text": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "text"
        ],
        "type": "object"
      },
      "maxItems": 4000,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "nlu_schema_version",
    "id",
    "text",
    "tokens",
    "bio_tags",
    "domain",
    "action",
    "slots",
    "disposition",
    "ood",
    "family",
    "source",
    "privacy",
    "review_status",
    "metadata",
    "composition",
    "scenario_id",
    "semantic_parent_id",
    "partition",
    "text_sha256",
    "family_registry_version",
    "scenario_registry_version",
    "generation",
    "quarantine_reasons",
    "privacy_review",
    "provenance",
    "review_history"
  ],
  "type": "object"
}
