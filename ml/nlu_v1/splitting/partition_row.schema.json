{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:metis:nlu:partition:001",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "nlu_v1_partition_row_001"
    },
    "nlu_schema_version": {
      "enum": [
        "nlu_v1_schema_001",
        "nlu_v1_schema_002"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "start",
          "end",
          "text"
        ],
        "additionalProperties": false
      },
      "maxItems": 4000,
      "minItems": 1
    },
    "bio_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "O",
          "B-PERSON",
          "I-PERSON",
          "B-SUBJECT",
          "I-SUBJECT",
          "B-DATE",
          "I-DATE",
          "B-TIME",
          "I-TIME",
          "B-DATE_RANGE",
          "I-DATE_RANGE",
          "B-DURATION",
          "I-DURATION",
          "B-STATUS",
          "I-STATUS",
          "B-PRIORITY",
          "I-PRIORITY",
          "B-LOCATION",
          "I-LOCATION",
          "B-PROJECT",
          "I-PROJECT",
          "B-GOAL",
          "I-GOAL",
          "B-TASK",
          "I-TASK",
          "B-EVENT",
          "I-EVENT",
          "B-FIELD",
          "I-FIELD",
          "B-KIND",
          "I-KIND",
          "B-RECURRENCE",
          "I-RECURRENCE",
          "B-QUANTITY",
          "I-QUANTITY",
          "B-CHANNEL",
          "I-CHANNEL",
          "B-PREFERENCE_VALUE",
          "I-PREFERENCE_VALUE",
          "B-REFERENCE",
          "I-REFERENCE"
        ]
      },
      "maxItems": 4000,
      "minItems": 1
    },
    "domain": {
      "type": "string",
      "enum": [
        "TASK",
        "CALENDAR",
        "MEMORY",
        "PROMISE",
        "PERSON",
        "GOAL",
        "PROJECT",
        "PLANNING",
        "REMINDER",
        "ALARM",
        "TIMER",
        "FOCUS",
        "HABIT",
        "COMMUNICATION",
        "NAVIGATION",
        "PREFERENCE",
        "REFLECTION",
        "KNOWLEDGE",
        "UNKNOWN"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "READ",
        "CREATE",
        "UPDATE",
        "DELETE",
        "COMPLETE",
        "POSTPONE",
        "START",
        "STOP",
        "SET",
        "PLAN",
        "REVIEW",
        "CALL",
        "SEND",
        "NAVIGATE",
        "RECOMMEND",
        "NONE"
      ]
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "PERSON",
              "SUBJECT",
              "DATE",
              "TIME",
              "DATE_RANGE",
              "DURATION",
              "STATUS",
              "PRIORITY",
              "LOCATION",
              "PROJECT",
              "GOAL",
              "TASK",
              "EVENT",
              "FIELD",
              "KIND",
              "RECURRENCE",
              "QUANTITY",
              "CHANNEL",
              "PREFERENCE_VALUE",
              "REFERENCE"
            ]
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "type",
          "start",
          "end",
          "text"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "disposition": {
      "type": "string",
      "enum": [
        "SUPPORTED_COMPLETE",
        "SUPPORTED_NEEDS_CONTEXT",
        "SUPPORTED_NEEDS_CONFIRMATION",
        "KNOWN_UNSUPPORTED",
        "OUT_OF_DOMAIN"
      ]
    },
    "ood": {
      "type": "boolean"
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "original_split": {
          "type": "string",
          "minLength": 1
        },
        "original_intent": {
          "type": "string",
          "minLength": 1
        },
        "mapper_version": {
          "type": "string",
          "minLength": 1
        },
        "mapping_version": {
          "type": "string",
          "minLength": 1
        },
        "mapping_decision": {
          "enum": [
            "MAP",
            "KNOWN_UNSUPPORTED",
            "OOD"
          ]
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "intake_approval_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_class": {
          "enum": [
            "PUBLIC_DATASET",
            "TRAINABLE_LEGACY",
            "CONTROLLED_SYNTHETIC",
            "INDEPENDENT_EVALUATION"
          ]
        }
      },
      "required": [
        "dataset",
        "version",
        "source_id",
        "original_split",
        "original_intent",
        "mapper_version",
        "mapping_version",
        "mapping_decision",
        "artifact_sha256",
        "intake_approval_id",
        "source_class"
      ],
      "additionalProperties": false
    },
    "privacy": {
      "const": "PUBLIC"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "semantic_parent_id": {
      "type": "string",
      "minLength": 1
    },
    "partition": {
      "enum": [
        "TRAIN",
        "DEVELOPMENT",
        "CALIBRATION",
        "SELECTION",
        "FINAL_INDEPENDENT_TEST",
        "PROTECTED_EVALUATION"
      ]
    },
    "generation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "parent_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "uniqueItems": true,
              "maxItems": 64
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "generator_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
            },
            "template_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
            }
          },
          "required": [
            "parent_ids",
            "seed",
            "generator_id",
            "template_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "license_id": {
      "type": "string",
      "minLength": 1
    },
    "canonical_facts_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canonical_review_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "nlu_schema_version",
    "id",
    "text",
    "tokens",
    "bio_tags",
    "domain",
    "action",
    "slots",
    "disposition",
    "ood",
    "family",
    "source",
    "privacy",
    "scenario_id",
    "semantic_parent_id",
    "partition",
    "generation",
    "license_id",
    "canonical_facts_sha256",
    "canonical_review_sha256"
  ],
  "additionalProperties": false
}
