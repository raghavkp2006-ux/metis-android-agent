{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "nlu_v1_schema_001"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "start",
          "end",
          "text"
        ],
        "additionalProperties": false
      },
      "maxItems": 4000,
      "minItems": 1
    },
    "bio_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "O",
          "B-PERSON",
          "I-PERSON",
          "B-SUBJECT",
          "I-SUBJECT",
          "B-DATE",
          "I-DATE",
          "B-TIME",
          "I-TIME",
          "B-DATE_RANGE",
          "I-DATE_RANGE",
          "B-DURATION",
          "I-DURATION",
          "B-STATUS",
          "I-STATUS",
          "B-PRIORITY",
          "I-PRIORITY",
          "B-LOCATION",
          "I-LOCATION",
          "B-PROJECT",
          "I-PROJECT",
          "B-GOAL",
          "I-GOAL",
          "B-TASK",
          "I-TASK",
          "B-EVENT",
          "I-EVENT",
          "B-FIELD",
          "I-FIELD",
          "B-KIND",
          "I-KIND",
          "B-RECURRENCE",
          "I-RECURRENCE",
          "B-QUANTITY",
          "I-QUANTITY",
          "B-CHANNEL",
          "I-CHANNEL",
          "B-PREFERENCE_VALUE",
          "I-PREFERENCE_VALUE",
          "B-REFERENCE",
          "I-REFERENCE"
        ]
      },
      "maxItems": 4000,
      "minItems": 1
    },
    "meaning": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "enum": [
            "TASK",
            "CALENDAR",
            "MEMORY",
            "PROMISE",
            "PERSON",
            "GOAL",
            "PROJECT",
            "PLANNING",
            "REMINDER",
            "ALARM",
            "TIMER",
            "FOCUS",
            "HABIT",
            "COMMUNICATION",
            "NAVIGATION",
            "PREFERENCE",
            "REFLECTION",
            "KNOWLEDGE",
            "UNKNOWN"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "READ",
            "CREATE",
            "UPDATE",
            "DELETE",
            "COMPLETE",
            "POSTPONE",
            "START",
            "STOP",
            "SET",
            "PLAN",
            "REVIEW",
            "CALL",
            "SEND",
            "NAVIGATE",
            "RECOMMEND",
            "NONE"
          ]
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "PERSON",
                  "SUBJECT",
                  "DATE",
                  "TIME",
                  "DATE_RANGE",
                  "DURATION",
                  "STATUS",
                  "PRIORITY",
                  "LOCATION",
                  "PROJECT",
                  "GOAL",
                  "TASK",
                  "EVENT",
                  "FIELD",
                  "KIND",
                  "RECURRENCE",
                  "QUANTITY",
                  "CHANNEL",
                  "PREFERENCE_VALUE",
                  "REFERENCE"
                ]
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "type",
              "start",
              "end",
              "text"
            ],
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "disposition": {
          "type": "string",
          "enum": [
            "SUPPORTED_COMPLETE",
            "SUPPORTED_NEEDS_CONTEXT",
            "SUPPORTED_NEEDS_CONFIRMATION",
            "KNOWN_UNSUPPORTED",
            "OUT_OF_DOMAIN"
          ]
        },
        "ood": {
          "type": "boolean"
        }
      },
      "required": [
        "domain",
        "action",
        "slots",
        "disposition",
        "ood"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "OUT_OF_DOMAIN"
              }
            }
          },
          "then": {
            "properties": {
              "domain": {
                "const": "UNKNOWN"
              },
              "action": {
                "const": "NONE"
              },
              "ood": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "ood": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": [
                  "SUPPORTED_COMPLETE",
                  "SUPPORTED_NEEDS_CONTEXT",
                  "SUPPORTED_NEEDS_CONFIRMATION"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "domain": {
                "not": {
                  "const": "UNKNOWN"
                }
              },
              "action": {
                "not": {
                  "const": "NONE"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "const": "UNKNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "action": {
                "const": "NONE"
              },
              "disposition": {
                "enum": [
                  "KNOWN_UNSUPPORTED",
                  "OUT_OF_DOMAIN"
                ]
              }
            }
          }
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
    },
    "language": {
      "const": "en-US"
    },
    "split": {
      "type": "string",
      "enum": [
        "TRAIN",
        "DEVELOPMENT",
        "CALIBRATION",
        "SELECTION",
        "FINAL_INDEPENDENT_TEST"
      ]
    },
    "family_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "source_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "source_record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "source_class": {
          "type": "string",
          "enum": [
            "PUBLIC_DATASET",
            "TRAINABLE_LEGACY",
            "CONTROLLED_SYNTHETIC",
            "INDEPENDENT_EVALUATION"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_split": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "mapper_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "license_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "approval_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "privacy": {
          "type": "string",
          "enum": [
            "PUBLIC_LICENSED",
            "SYNTHETIC_NONPERSONAL",
            "CONSENTED_REDACTED",
            "PRIVATE_DO_NOT_PUBLISH"
          ]
        },
        "author_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "reviewer_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "generator_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
          },
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "source_id",
        "source_version",
        "source_record_id",
        "source_class",
        "source_sha256",
        "source_split",
        "mapper_version",
        "license_id",
        "approval_id",
        "privacy",
        "author_id",
        "reviewer_id",
        "generator_id",
        "parent_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "text",
    "tokens",
    "bio_tags",
    "meaning",
    "id",
    "language",
    "split",
    "family_id",
    "scenario_id",
    "provenance"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "split": {
            "const": "FINAL_INDEPENDENT_TEST"
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "source_class": {
                "const": "INDEPENDENT_EVALUATION"
              },
              "generator_id": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "source_class": {
                "const": "CONTROLLED_SYNTHETIC"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "generator_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
              },
              "privacy": {
                "const": "SYNTHETIC_NONPERSONAL"
              }
            }
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:metis:nlu:v1:record",
  "title": "METIS NLU v1 record"
}
