# Gradle files
.gradle/
.gradle-user-home/
.android-local/
.kotlin/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Development-only Python evaluation caches
__pycache__/
.venv-phase15/

# Private immutable incident/source archives, kept outside Gradle clean outputs.
/.local-evidence/

# Retirement evidence is local/private; never publish raw prompts, vocabularies or audit snapshots.
/archive/legacy_ml/private/
/datasets/legacy/private/*
!/datasets/legacy/private/README.md
# Existing tracked deterministic fixtures/history remain versioned. New legacy data is quarantined.
/docs/evaluation/phase15/**

# NLU working data stays local; publish only through the reviewed export path.
/ml/nlu_v1/datasets/raw/*
!/ml/nlu_v1/datasets/raw/README.md
/ml/nlu_v1/datasets/canonical/*
!/ml/nlu_v1/datasets/canonical/README.md
/ml/nlu_v1/datasets/quarantine/*
!/ml/nlu_v1/datasets/quarantine/README.md
/ml/nlu_v1/datasets/frozen/*
!/ml/nlu_v1/datasets/frozen/README.md
